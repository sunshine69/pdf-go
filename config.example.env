# signsrv configuration example.
#
# Every key below can be given as <KEY> in the environment, or in a
# file passed with -config. The environment wins over the file. Secrets are
# read from the environment first, then from the file, and are never logged.
#
# Run:  signsrv checkconfig -config config.example.env
#       signsrv serve       -config config.example.env

# Any address is accepted. Loopback is the default because the usual shape is a
# proxy in front with TLS terminated there. Bind 0.0.0.0 (or leave the host off
# entirely: :8080 means every interface) and `serve` logs a warning, and runs —
# the service speaks plain HTTP, so TLS, a proxy, or network policy has to
# terminate encryption in front of it. Where the listener sits is the
# deployment's decision, not the binary's.
listen=127.0.0.1:8080

# Public origin of the service. Signing links are built from it. It must be
# https:// outside dev mode, because the link is the credential.
public_url=https://sign.example.org

# Paths.
db=var/signsrv.db
storage_dir=var/storage
keystore_dir=var/keystore
outbox_dir=var/outbox

# CA certificate identity. Used ONLY when the keystore is created on first
# start; changing them later has no effect on an existing ca.crt. All fields
# are optional -- unset keys are omitted from the distinguished name, and if
# none are set the CA is named "signsrv CA".
#
# These strings are self-asserted. A self-signed certificate attests nothing
# about the party named in it, so a fuller subject makes the certificate more
# legible to humans and PDF readers, not more trusted: trust comes from
# importing ca.crt and checking its fingerprint over a channel the signer does
# not control.
ca_common_name=Example.org Document Signing CA
ca_org=Example Ltd
ca_unit=Trust Services
ca_street=1 Example Street
ca_locality=Example City
ca_province=Example County
ca_postal=EX1 2AB
ca_country=GB
ca_email=signing@example.org

log_path=var/log/signsrv.jsonl
# audit_dir holds the nightly audit files (one .jsonl per day) that
# `signsrv audit-write` appends to and `signsrv audit-verify` checks.
audit_dir=var/audit
log_level=info

# downloads_dir holds the verification tool binaries the recipient guide links
# to (/dl/signsrv-linux-amd64, /dl/signsrv-windows-amd64.exe). Empty means the
# instance publishes no downloads. scripts/build-release.sh writes them here.
# The files are served by exact name from a fixed list, so this directory is
# read-only over the network and nothing else in it is reachable.
# downloads_dir=var/downloads
# Secrets. Prefer the environment for these three.
keystore_pass=change-me-protects-the-signing-ca-key
admin_password=change-me-seeds-the-admin-account
smtp_pass=

# JWT signing key. Created on first start if missing.
jwt_secret_file=var/jwt.ed25519.key

# Signing policy.
tsa_url=https://freetsa.org/tsr
link_ttl=168h
max_pdf_mb=25
# How often the in-process worker drains the mail queue and the signing queue.
# Set it to 0 to run the drainer separately as `signsrv worker`.
worker_interval=15s

# Mail. In dev mode (dev=true) mail is written to outbox_dir and SMTP is
# never contacted.
smtp_host=smtp.example.org
smtp_port=587
smtp_starttls=true
smtp_user=signsrv
smtp_pass=
mail_from=signsrv@example.org

# Set true only when a reverse proxy in front of signsrv sets X-Forwarded-For.
# Behind a proxy this MUST be true, or every visitor shares one bucket and the
# first login flood locks the whole service out.
trust_proxy=false

# Rate limits, in requests per rate_limit_window (one minute unless you change
# it). Every line is optional: unset means the built-in default shown here, and
# an instance with no rate_limit_ lines runs the limits it always ran with.
# A negative value switches that bucket off entirely.
#
# Counted per source address, except consent and remind, which are per
# envelope: a party cannot escape those by changing address, and neighbours
# behind one office IP cannot starve each other. In memory and per process, so
# two replicas double the budget and a restart clears the counters.
#
#   rate_limit_login=5         # every attempt runs argon2id, so this is the CPU guard
#   rate_limit_claim=10        # a signing link being opened and claimed
#   rate_limit_consent=10      # per envelope, not per address
#   rate_limit_link=60         # reading the envelope and the document behind a link
#   rate_limit_create=20       # a create costs a fill, a signature and a TSA round trip
#   rate_limit_send=30         # also the bucket for cancel, reissue, sign and sweep
#   rate_limit_api=600         # any other authenticated call
#   rate_limit_remind=2        # per envelope, over rate_limit_remind_window
#   rate_limit_mail_test=6     # the admin "send a test mail" button
#   rate_limit_window=1m
#   rate_limit_remind_window=10m

# dev=true: no SMTP, secrets generated at start and printed to the log, verbose
# errors. Never in production.
dev=false

# Not a config key, so it is not in this file: DEFAULT_ADMIN_EMAIL names the
# admin account the first start of an empty instance creates, hashed with
# ADMIN_PASSWORD above. Environment only, honoured on the first start only;
# unset falls back to admin@pdfsign.com and the log says so. After that,
# signsrv admin add / admin passwd decide who is an admin.
