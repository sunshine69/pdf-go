# /lib/systemd/system/signsrv.service — shipped by the signsrv Debian package.
#
# Differences from deploy/signsrv.service (the documentation copy in the repo), both
# of which are install-breaking:
#
#   1. StateDirectory replaces a bare WorkingDirectory. Under ProtectSystem=strict the
#      whole filesystem except /dev, /proc and /sys is mounted read-only, so a unit
#      that grants no write path cannot create its SQLite database, its keystore or
#      its log: it fails at the first write. StateDirectory also creates
#      /var/lib/signsrv owned by User=/Group= before ExecStart, which is what makes a
#      fresh install start.
#
#   2. EnvironmentFile replaces the LoadCredential + "%k" pair. %k is not a systemd
#      specifier (the specifiers that read credentials are %i %s %n ...) so those two
#      Environment= lines delivered the literal string "%kkeystore-pass" as the
#      passphrase and the admin password: the service would start, create a CA under a
#      garbage passphrase, and then no later run could read it. LoadCredential also
#      needs the process to read $CREDENTIALS_DIRECTORY, which signsrv never does.
#
# The secrets file is 0600 root:root. PID 1 reads it as root and puts the values in the
# child's environment; the service user cannot read the file, only inherit the two
# variables. That is the same property LoadCredential was reaching for.

[Unit]
Description=signsrv PDF signing service
Documentation=https://github.com/sunshine69/pdf-go
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=signsrv
Group=signsrv

# Files the process creates are group-unreadable and other-unreadable, so key
# material, the JWT key and the audit files never land world-readable.
UMask=0027

WorkingDirectory=/var/lib/signsrv
# Creates /var/lib/signsrv before ExecStart, owned by User=/Group= with mode
# StateDirectoryMode. The "name:owner:group" form belongs to tmpfiles.d, not here.
StateDirectory=signsrv
StateDirectoryMode=0750

# Secrets: keystore passphrase and admin password. Not in the unit, not in the
# operator-readable config, and not in the shell history.
EnvironmentFile=/etc/signsrv/secrets.env

# + runs this as root, outside the sandbox below, which is what lets it create and
# chown directories. Idempotent and cheap. It is what makes the install come up, and
# what makes it self-heal if the state directory is damaged later. A keystore whose
# passphrase is gone makes it refuse to start, deliberately: inventing a new passphrase
# would orphan the CA encrypted with the old one and silently invalidate every
# document already signed.
ExecStartPre=+/usr/lib/signsrv/signsrv-firstboot.sh
ExecStart=/usr/bin/signsrv serve -config /etc/signsrv/signsrv.env
ExecReload=/bin/kill -HUP $MAINPID

# The process keeps no capabilities. It binds a high port (8080) so it needs no
# NET_BIND_SERVICE, and it writes only inside its own state directory.
NoNewPrivileges=true
AmbientCapabilities=
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallFilter=@system-service
SystemCallArchitectures=native

# The listener comes from /etc/signsrv/signsrv.env, and is loopback by default: the
# service speaks plain HTTP and TLS belongs to the proxy in front of it. A bind beyond
# loopback is accepted, not refused; `serve` logs the warning about terminating
# encryption in front of it.

# A request that is signing can take up to 90 seconds (the TSA call). A shutdown that
# kills it mid-write leaves an envelope in the middle of a batch, so the drain gets
# time to finish.
TimeoutStopSec=120
Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=signsrv

[Install]
WantedBy=multi-user.target
